using Avalonia.Controls;
using Avalonia.Interactivity;
using curs.Data;
using curs.Services;

namespace curs
{
    public partial class LoginWindow : Window
    {
        public LoginWindow()
        {
            InitializeComponent();

            Database.Initialize();
            Database.CreateDefaultAdmin();

            var loginBtn = this.FindControl<Button>("LoginButton");
            var regBtn = this.FindControl<Button>("RegisterButton");
            var forgotBtn = this.FindControl<Button>("ForgotButton");

            if (loginBtn != null)
                loginBtn.Click += LoginButton_Click;
            if (regBtn != null)
                regBtn.Click += RegisterButton_Click;
            if (forgotBtn != null)
                forgotBtn.Click += ForgotButton_Click;
        }

        private void LoginButton_Click(object? sender, RoutedEventArgs e)
        {
            var userBox = this.FindControl<TextBox>("UsernameBox");
            var passBox = this.FindControl<TextBox>("PasswordBox");
            var status = this.FindControl<TextBlock>("StatusText");

            var username = userBox?.Text ?? string.Empty;
            var password = passBox?.Text ?? string.Empty;

            var user = AuthService.Authenticate(username, password);
            if (user != null)
            {
                Window? next = null;
                if (user.Role == "admin")
                    next = new AdminWindow(user);
                else
                    next = new MainWindow(user);

                next.Show();
                this.Close();
            }
            else
            {
                if (status != null)
                    status.Text = "Неверное имя пользователя или пароль";
            }
        }

        private void RegisterButton_Click(object? sender, RoutedEventArgs e)
        {
            var userBox = this.FindControl<TextBox>("UsernameBox");
            var passBox = this.FindControl<TextBox>("PasswordBox");
            var emailBox = this.FindControl<TextBox>("EmailBox");
            var nameBox = this.FindControl<TextBox>("NameBox");
            var status = this.FindControl<TextBlock>("StatusText");

            var username = userBox?.Text ?? string.Empty;
            var password = passBox?.Text ?? string.Empty;
            var email = emailBox?.Text ?? string.Empty;
            var name = nameBox?.Text ?? string.Empty;

            if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
            {
                if (status != null)
                    status.Text = "Введите имя и пароль";
                return;
            }

            // check email
            if (!string.IsNullOrWhiteSpace(email) && AuthService.EmailExists(email))
            {
                if (status != null) status.Text = "Эта почта уже зарегистрирована";
                return;
            }

            if (AuthService.UsernameExists(username))
            {
                if (status != null) status.Text = "Имя пользователя уже занято";
                return;
            }

            var ok = AuthService.Register(username, password, email, name);
            if (ok)
            {
                if (status != null)
                    status.Text = "Пользователь создан. Войдите.";
            }
            else
            {
                if (status != null)
                    status.Text = "Не удалось создать пользователя";
            }
        }

        private void ForgotButton_Click(object? sender, RoutedEventArgs e)
        {
            var win = new ForgotWindow();
            win.ShowDialog(this);
        }
    }
}
