<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="curs.TestTakingWindow"
        Title="Прохождение теста">
    <DockPanel Margin="10">
        <ScrollViewer DockPanel.Dock="Top" Name="Scroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="QuestionsHost" Spacing="8" />
        </ScrollViewer>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="SubmitButton">Завершить</Button>
            <Button x:Name="CancelButton">Отмена</Button>
        </StackPanel>
    </DockPanel>
</Window>
