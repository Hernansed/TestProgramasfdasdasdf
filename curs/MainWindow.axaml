<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="curs.MainWindow"
        Title="curs">
    <StackPanel Margin="10" Spacing="8">
        <TextBlock Text="Пример графического интерфейса" FontSize="18" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="UserLabel" Text="" FontSize="12" />
            <Button x:Name="LogoutButton" Content="Выйти" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="InputTextBox" Width="220" Watermark="Введите текст..." />
            <Button x:Name="AddButton" Click="AddButton_Click">Добавить</Button>
            <Button x:Name="ClearButton" Click="ClearButton_Click">Очистить</Button>
            <Button x:Name="TakeTestButton">Пройти тест</Button>
        </StackPanel>

        <ListBox x:Name="ItemsListBox" Height="200" />
    </StackPanel>
</Window>
