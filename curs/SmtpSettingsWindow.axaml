<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="curs.SmtpSettingsWindow"
        Title="SMTP настройки">
    <StackPanel Margin="20" Spacing="8" Width="420">
        <TextBlock Text="SMTP настройки" FontSize="16" />
        <TextBox x:Name="HostBox" Watermark="SMTP хост" />
        <TextBox x:Name="PortBox" Watermark="Порт" />
        <TextBox x:Name="UserBox" Watermark="Пользователь" />
        <TextBox x:Name="PassBox" Watermark="Пароль" />
        <TextBox x:Name="FromBox" Watermark="От кого (From)" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="SaveButton">Сохранить</Button>
            <Button x:Name="CancelButton">Отмена</Button>
        </StackPanel>
        <TextBlock x:Name="StatusText" Foreground="Green" />
    </StackPanel>
</Window>
