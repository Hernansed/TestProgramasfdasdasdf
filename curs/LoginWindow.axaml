<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="curs.LoginWindow"
        Title="Вход">
    <StackPanel Margin="20" Spacing="8" Width="320">
        <TextBlock Text="Вход в систему" FontSize="16" />
        <TextBox x:Name="UsernameBox" Watermark="Имя пользователя" />
        <TextBox x:Name="PasswordBox" Watermark="Пароль" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="LoginButton">Войти</Button>
            <Button x:Name="RegisterButton">Зарегистрироваться</Button>
            <Button x:Name="ForgotButton">Забыли пароль</Button>
        </StackPanel>
        <TextBlock x:Name="StatusText" Foreground="Red" />
    </StackPanel>
</Window>
