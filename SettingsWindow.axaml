<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="curs.SettingsWindow"
        Title="Настройки"
        Width="600"
        Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="Настройки приложения" FontSize="18" FontWeight="Bold" />
        
        <Separator />
        
        <StackPanel Spacing="10">
            <TextBlock Text="Тема оформления:" FontSize="14" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <RadioButton x:Name="LightThemeRadio" Content="Светлая" GroupName="Theme" />
                <RadioButton x:Name="DarkThemeRadio" Content="Тёмная" GroupName="Theme" />
                <RadioButton x:Name="DefaultThemeRadio" Content="По умолчанию" GroupName="Theme" />
            </StackPanel>
        </StackPanel>

        <Separator />

        <StackPanel Spacing="10">
            <TextBlock Text="Цвет акцента:" FontSize="14" FontWeight="Bold" />
            
            <StackPanel Orientation="Horizontal" Spacing="15">
                <Border BorderThickness="1" BorderBrush="#CCCCCC" CornerRadius="3">
                    <Canvas x:Name="ColorPickerCanvas" 
                            Background="White" 
                            Width="350" 
                            Height="250" />
                </Border>
                
                <StackPanel Spacing="10" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Превью:" FontSize="12" Foreground="#666666" Margin="0,0,0,5" />
                        <Border Width="60" 
                               Height="60" 
                               BorderThickness="2" 
                               BorderBrush="#999999" 
                               Background="#FFFFFF">
                            <Rectangle x:Name="ColorPreview" />
                        </Border>
                    </StackPanel>
                    
                    <TextBlock x:Name="ColorHexText" 
                              Text="Цвет:&#10;#0078D7" 
                              FontSize="11" 
                              Foreground="#666666" 
                              LineHeight="16" 
                              HorizontalAlignment="Center" />
                    
                    <Button x:Name="ApplyColorButton" 
                           Content="✓ Применить&#10;цвет" 
                           Padding="8,12"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           FontSize="11" />
                </StackPanel>
            </StackPanel>
            
            <TextBlock Text="Быстрый выбор цветов:" FontSize="12" Foreground="#666666" />
            
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="Color1" Width="40" Height="40" Padding="0" ToolTip.Tip="Синий" />
                <Button x:Name="Color2" Width="40" Height="40" Padding="0" ToolTip.Tip="Красный" />
                <Button x:Name="Color3" Width="40" Height="40" Padding="0" ToolTip.Tip="Зелёный" />
                <Button x:Name="Color4" Width="40" Height="40" Padding="0" ToolTip.Tip="Оранжевый" />
                <Button x:Name="Color5" Width="40" Height="40" Padding="0" ToolTip.Tip="Фиолетовый" />
            </StackPanel>
        </StackPanel>

        <Separator />

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="OK" Width="80" />
            <Button x:Name="CancelButton" Content="Отмена" Width="80" />
        </StackPanel>
    </StackPanel>
</Window>
